{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*",
    "types/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}